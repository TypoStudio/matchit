rules_version = '2';
// 익명 점수 랭킹 보안 규칙. Firebase 콘솔 > Firestore Database > 규칙 에 그대로 붙여넣기.
// - 누구나 순위표를 읽을 수 있음(read 공개)
// - 쓰기는 익명 로그인된 본인 문서(uid == 문서ID)만, 점수·닉네임 형식 검증
// App Check 방어는 규칙(request.app)이 아니라 서비스 레벨 enforcement로 거는 것이 정석.
// (UNENFORCED 상태에서 request.app은 유효 토큰이 있어도 비어 정상 쓰기까지 막힘)
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{board}/scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000000
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 16;
      // 본인 문서 삭제 허용(익명→구글 계정 전환 시 옛 익명 기록 이전·정리용)
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 개인 클라우드 세이브(설정·진행기록) — 본인만 읽고 씀
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
